<li class="">
    <a href="#{{ tabId }}-container" role="tab" data-toggle="tab" id="{{ tabId }}">
        {% if count is defined %}
        <span size="sm" class="label label-primary mr-sm" id="{{ tabId }}-count">
            {{ count }}
        </span>
        {% endif %}
        {{ title|trans|e }}
    </a>
</li>
